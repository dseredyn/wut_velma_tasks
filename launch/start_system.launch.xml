<?xml version="1.0"?>
<launch>
    <arg name="world" default="table_high_cylinder.world"/>

    <!-- Environment variables for Gazebo Sim -->
    <set_env
        name="GZ_SIM_RESOURCE_PATH"
        value="$(find-pkg-share wut_velma_tasks)/worlds:$(env GZ_SIM_RESOURCE_PATH '')" />

    <!-- Start system -->
    <include file="$(find-pkg-share wut_velma_gazebo)/launch/start_system.launch.py">
        <arg name="world" value="$(var world)"/>
    </include>

</launch>
